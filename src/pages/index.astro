---
import FlagQuiz from "../components/FlagQuiz.tsx";
import "../styles/global.css";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#eef1f8" />
    <title>Guess the Flag</title>
  </head>
  <body>
    <header class="topbar">
      <button type="button" class="brand" data-home>
        <span class="brand__mark" aria-hidden="true">🌍</span>
        Guess the Flag
      </button>
    </header>

    <main class="page">
      <FlagQuiz client:only="react" />
    </main>

    <script>
      // Phone keyboards shrink the visual viewport but not the layout
      // viewport (iOS never exposes the keyboard to CSS), so publish its
      // height for the game screen to fit inside - see .quiz--game in
      // global.css. Safari also scrolls the focused input into view while
      // the keyboard animates; once the screen fits, that offset is junk.
      const vv = window.visualViewport;
      if (vv) {
        const fit = () => {
          document.documentElement.style.setProperty("--vvh", `${vv.height}px`);
          if (document.querySelector(".quiz--game")) window.scrollTo(0, 0);
        };
        vv.addEventListener("resize", fit);
        fit();
      }

      // The brand sits outside the React island; a click asks the island to
      // return to its menu (see the "gtf:home" listener in FlagQuiz.tsx).
      for (const el of document.querySelectorAll("[data-home]")) {
        el.addEventListener("click", () => {
          window.dispatchEvent(new CustomEvent("gtf:home"));
        });
      }
    </script>
  </body>
</html>
